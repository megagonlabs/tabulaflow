  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#f8f4f0"}
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "osm",
      "source-layer": "ocean",
      "paint": {"fill-color": "#c2def3"}
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "land",
      "minzoom": 7,
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          ["glacier", "ice_shelf"], "#ffffff",
          ["residential", "suburb", "neighbourhood"], "rgba(232, 226, 219, 0.36)",
          ["forest", "wood"], "#d8e8c8",
          ["grass", "meadow", "park", "recreation_ground"], "#d8e8c8",
          ["sand", "beach"], "#f2e4bf",
          ["scrub", "heath"], "#e5ecd4",
          "#edf1e3"
        ],
        "fill-opacity": 0.82
      }
    },
    {
      "id": "sites",
      "type": "fill",
      "source": "osm",
      "source-layer": "sites",
      "minzoom": 14,
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          ["park", "garden", "playground"], "#d8e8c8",
          ["commercial"], "rgba(255, 210, 210, 0.28)",
          ["industrial"], "rgba(255, 235, 170, 0.34)",
          ["railway"], "rgba(232, 226, 219, 0.4)",
          ["school", "university", "college"], "#f0e8f8",
          ["hospital"], "#ffdde9",
          ["cemetery"], "#e0e4dd",
          "#eee9df"
        ],
        "fill-opacity": 0.78
