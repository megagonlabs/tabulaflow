{
  "version": 8,
  "name": "TabulaFlow Shortbread Light",
  "center": [0, 20],
  "zoom": 1.2,
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://vector.openstreetmap.org/shortbread_v1/tilejson.json",
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\">© OpenStreetMap</a> | Style inspired by <a href=\"https://github.com/openmaptiles/osm-bright-gl-style\">OSM Bright</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#f8f4f0"}
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "osm",
      "source-layer": "ocean",
      "paint": {"fill-color": "#c2def3"}
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "land",
      "minzoom": 7,
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          ["forest", "wood"], "#d8e8c8",
          ["grass", "meadow", "park", "recreation_ground"], "#d8e8c8",
          ["sand", "beach"], "#f2e4bf",
          ["scrub", "heath"], "#e5ecd4",
          "#edf1e3"
        ],
        "fill-opacity": 0.82
      }
    },
    {
      "id": "sites",
      "type": "fill",
      "source": "osm",
      "source-layer": "sites",
      "minzoom": 14,
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          ["park", "garden", "playground"], "#d8e8c8",
          ["school", "university", "college"], "#f0e8f8",
          ["hospital"], "#ffdde9",
          ["cemetery"], "#e0e4dd",
          "#eee9df"
        ],
        "fill-opacity": 0.78
      }
    },
    {
      "id": "water-polygons",
      "type": "fill",
      "source": "osm",
      "source-layer": "water_polygons",
      "minzoom": 5,
      "paint": {"fill-color": "#c2def3"}
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "osm",
      "source-layer": "water_lines",
      "minzoom": 9,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#8bc9ed",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.7, 14, 2.4]
      }
    },
    {
      "id": "street-polygons",
      "type": "fill",
      "source": "osm",
      "source-layer": "street_polygons",
      "minzoom": 11,
      "paint": {"fill-color": "#efebe7", "fill-opacity": 0.9}
    },
    {
      "id": "streets-minor-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 12,
      "filter": ["match", ["get", "kind"], ["residential", "unclassified", "service", "track", "path", "footway", "cycleway"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#d8d1ca",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 14, 3.1, 16, 7],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0, 12.5, 0.75]
      }
    },
    {
      "id": "streets-rail",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 8,
      "filter": ["==", ["get", "rail"], true],
      "paint": {
        "line-color": "#b8b0a8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 1.4],
        "line-dasharray": [1, 1.4]
      }
    },
    {
      "id": "streets-minor",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 11,
      "filter": ["match", ["get", "kind"], ["residential", "unclassified", "service", "track", "path", "footway", "cycleway"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.7, 14, 2.3, 16, 6],
        "line-opacity": 0.96
      }
    },
    {
      "id": "streets-secondary-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 7,
      "filter": ["match", ["get", "kind"], ["secondary", "tertiary"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#e7c27c",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1.1, 12, 3.1, 14, 5.6, 16, 10],
        "line-opacity": 0.82
      }
    },
    {
      "id": "streets-secondary",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 8,
      "filter": ["match", ["get", "kind"], ["secondary", "tertiary"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#fff4c6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 12, 2.1, 14, 4.2, 16, 8],
        "line-opacity": 0.98
      }
    },
    {
      "id": "streets-primary-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 5,
      "filter": ["match", ["get", "kind"], ["trunk", "primary"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#e5ad66",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.2, 10, 3.5, 14, 6.6, 16, 11.5],
        "line-opacity": 0.9
      }
    },
    {
      "id": "streets-primary",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 5,
      "filter": ["match", ["get", "kind"], ["trunk", "primary"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffea9a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 10, 2.5, 14, 5, 16, 9]
      }
    },
    {
      "id": "streets-motorway-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 5,
      "filter": ["==", ["get", "kind"], "motorway"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#d99b61",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.4, 10, 4, 14, 7.4, 16, 13],
        "line-opacity": 0.9
      }
    },
    {
      "id": "streets-motorway",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 5,
      "filter": ["==", ["get", "kind"], "motorway"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffd6a6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.9, 10, 2.8, 14, 5.4, 16, 10.4]
      }
    },
    {
      "id": "ferries",
      "type": "line",
      "source": "osm",
      "source-layer": "ferries",
      "minzoom": 11,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#6c9fb6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.8, 14, 1.5],
        "line-dasharray": [2, 2],
        "line-opacity": 0.7
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "osm",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {"fill-color": "#dfdbd7", "fill-opacity": 0.78}
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "osm",
      "source-layer": "boundaries",
      "minzoom": 2,
      "filter": ["==", ["get", "maritime"], false],
      "paint": {
        "line-color": "#aaa7b4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.6, 8, 1.1],
        "line-dasharray": [3, 1, 1, 1],
        "line-opacity": 0.62
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_polygons_labels",
      "minzoom": 10,
      "filter": [">=", ["to-number", ["get", "way_area"], 0], 1000000],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 12, 13, 14, 16, 16],
        "text-max-width": 7,
        "text-padding": 20
      },
      "paint": {
        "text-color": "#5b97bf",
        "text-halo-color": "rgba(255,255,255,0.72)",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "water-line-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_lines_labels",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 12, 16, 14],
        "text-max-width": 6
      },
      "paint": {
        "text-color": "#5b97bf",
        "text-halo-color": "rgba(255,255,255,0.72)",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "street-labels-major",
      "type": "symbol",
      "source": "osm",
      "source-layer": "street_labels",
      "minzoom": 11,
      "filter": ["match", ["get", "kind"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 320,
        "text-field": ["coalesce", ["get", "ref"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 12, 14, 14, 16, 16]
      },
      "paint": {
        "text-color": "#6a6257",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "street-labels-local",
      "type": "symbol",
      "source": "osm",
      "source-layer": "street_labels",
      "minzoom": 14,
      "filter": ["match", ["get", "kind"], ["residential", "unclassified"], true, false],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 420,
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 12, 16, 14]
      },
      "paint": {
        "text-color": "#7a746d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "ferry-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "ferries",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 12, 15, 14]
      },
      "paint": {
        "text-color": "#3589b6",
        "text-halo-color": "#e7f6ff",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "place-labels-major",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place_labels",
      "minzoom": 4,
      "filter": [
        "all",
        ["match", ["get", "kind"], ["city", "town"], true, false],
        [">=", ["to-number", ["get", "population"], 0], 250000]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 13, 10, 19, 14, 28],
        "text-padding": 18,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "rgba(255,255,255,0.82)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels-regional",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place_labels",
      "minzoom": 8,
      "filter": [
        "all",
        ["match", ["get", "kind"], ["city", "town"], true, false],
        [">=", ["to-number", ["get", "population"], 0], 50000],
        ["<", ["to-number", ["get", "population"], 0], 250000]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 13, 13, 17, 15, 20],
        "text-padding": 14,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4a4a4a",
        "text-halo-color": "rgba(255,255,255,0.82)",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-labels-neighborhood",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place_labels",
      "minzoom": 12,
      "filter": ["match", ["get", "kind"], ["suburb", "quarter", "neighbourhood"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 12, 14, 15, 16, 17],
        "text-padding": 20,
        "text-max-width": 11,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#4e5258",
        "text-halo-color": "rgba(255,255,255,0.82)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels-local",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place_labels",
      "minzoom": 11,
      "filter": [
        "all",
        ["match", ["get", "kind"], ["city", "town", "village"], true, false],
        [">=", ["to-number", ["get", "population"], 0], 5000],
        ["<", ["to-number", ["get", "population"], 0], 50000]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 12, 14, 15, 16, 17],
        "text-padding": 12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#5f6266",
        "text-halo-color": "rgba(255,255,255,0.82)",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "place-labels-small",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place_labels",
      "minzoom": 13,
      "filter": [
        "all",
        ["match", ["get", "kind"], ["village", "hamlet", "locality"], true, false],
        ["<", ["to-number", ["get", "population"], 0], 5000]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 12, 16, 15],
        "text-padding": 12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6b6e72",
        "text-halo-color": "rgba(255,255,255,0.82)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "public-transport-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "public_transport",
      "minzoom": 13,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 11, 16, 14],
        "text-padding": 12,
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "pois",
      "minzoom": 15,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 15, 11, 16, 13],
        "text-padding": 10,
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#007681",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "country-labels-global",
      "type": "symbol",
      "source": "osm",
      "source-layer": "boundary_labels",
      "minzoom": 0,
      "maxzoom": 8,
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 2],
        [">=", ["to-number", ["get", "way_area"], 0], 8000000000000]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 0, 11, 4, 17, 7, 19],
        "text-transform": "uppercase",
        "text-max-width": 6.25,
        "text-letter-spacing": 0
      },
      "paint": {
        "text-color": "#333344",
        "text-halo-blur": 1,
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 2
      }
    },
    {
      "id": "country-labels-regional",
      "type": "symbol",
      "source": "osm",
      "source-layer": "boundary_labels",
      "minzoom": 2,
      "maxzoom": 8,
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 2],
        [">=", ["to-number", ["get", "way_area"], 0], 1000000000000],
        ["<", ["to-number", ["get", "way_area"], 0], 8000000000000]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 11, 5, 17, 7, 18],
        "text-transform": "uppercase",
        "text-max-width": 6.25,
        "text-letter-spacing": 0
      },
      "paint": {
        "text-color": "#333344",
        "text-halo-blur": 1,
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 2
      }
    },
    {
      "id": "country-labels-local",
      "type": "symbol",
      "source": "osm",
      "source-layer": "boundary_labels",
      "minzoom": 3,
      "maxzoom": 8,
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 2],
        ["<", ["to-number", ["get", "way_area"], 0], 1000000000000]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 10, 6, 15, 8, 16],
        "text-transform": "uppercase",
        "text-max-width": 6.25,
        "text-letter-spacing": 0
      },
      "paint": {
        "text-color": "#333344",
        "text-halo-blur": 1,
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 2
      }
    }
  ]
}
