TabulaflowApp {
    background: $surface;
}

#chat-log {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
    padding: 0 1 2 1;
}

/* Scrollbar */
#chat-log {
    scrollbar-color: #666666;
    scrollbar-color-hover: #3EB489;
    scrollbar-color-active: #3EB489;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
}

#bottom-bar {
    dock: bottom;
    height: auto;
}

.bottom-sep {
    height: 1;
    color: #4a4a4a;
    background: transparent;
    text-wrap: nowrap;
}

#input-row {
    layout: horizontal;
    height: auto;
    max-height: 5;
    align-vertical: bottom;
    border-left: heavy #3EB489;
}

.input-sep {
    width: 1;
    height: 1;
    padding: 0;
    background: transparent;
    color: #444444;
}

#input-bar {
    width: 1fr;
    height: 1;
    max-height: 5;
    scrollbar-size: 0 0;
    border: none;
    padding: 0 1;
    background: transparent;
}

#input-bar:focus {
    border: none;
    background: transparent;
}

#open-explorer-btn {
    /* Fixed width sized to the longest label ("Ctrl+O  Open data explorer")
       so the button reserves its space up front: the layout doesn't shift when
       the label swaps loading -> ready. text-wrap: nowrap keeps the label on a
       single line — without it Textual wraps the label to the button's height. */
    width: 30;
    text-wrap: nowrap;
    height: 1;
    margin: 0;
    padding: 0 2;
    border: none;
    background: transparent;
    color: $text;
    text-style: none;
    min-width: 0;
}

#bottom-status {
    layout: horizontal;
    height: 1;
    background: transparent;
}

#bottom-status-model {
    width: 1fr;
    min-width: 0;
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    text-align: left;
}

#bottom-status-url {
    width: auto;
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $text;
    text-wrap: nowrap;
    text-align: right;
}

#open-explorer-btn:hover {
    background: $focus-surface;
    background-tint: $foreground 5%;
}

#open-explorer-btn:focus {
    text-style: none;
    background: $focus-surface;
}

#open-explorer-btn.-active {
    background: transparent;
    background-tint: $foreground 10%;
    text-style: none;
}
