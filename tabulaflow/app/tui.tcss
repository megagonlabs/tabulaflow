TabulaflowApp {
    background: $surface;
}

#chat-log {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 1 2 1;
}

/* Scrollbar */
#chat-log {
    scrollbar-color: #666666;
    scrollbar-color-hover: #3EB489;
    scrollbar-color-active: #3EB489;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
}

#input-row {
    dock: bottom;
    layout: horizontal;
    height: 3;
}

/* Prompt bar (UserMessage-style) and section separators. Each is a
   single-glyph Static rendered in a 3-row container with vertical
   padding, so the visible bar spans only the middle row even though
   the surrounding sections are 3 rows tall. */
#input-prompt {
    width: 1;
    height: 3;
    padding: 1 0;
    background: transparent;
    color: #3EB489;
    text-style: bold;
}

.input-sep {
    width: 1;
    height: 3;
    padding: 1 0;
    background: transparent;
    color: #666666;
}

#input-bar {
    /* No background box; the mint bar is rendered by the sibling
       ``#input-prompt`` Static (single-row glyph) instead of a CSS
       border, so the bar height matches the text row. */
    width: 1fr;
    height: 3;
    border: none;
    padding: 1 1;
    background: transparent;
}

#input-bar:focus {
    border: none;
    background: transparent;
}

#input-esc-hint {
    /* A (non-focusable) Button, not a Static, so its disabled state fades
       exactly like the sibling "Open data explorer" button — Button's built-in
       :disabled styling dims its colored label more than a Static would.
       Fixed width sized for the longer label ("Esc  Go to results" = 18 chars)
       + padding (2 + 2), left-aligned so "Esc" doesn't shift when the label
       toggles to the shorter "Go to input". */
    width: 22;
    height: 3;
    margin: 0;
    padding: 0 2;
    border: none;
    background: transparent;
    color: $text;
    text-style: none;
    min-width: 0;
}

#input-esc-hint:disabled {
    /* Textual applies its disabled dimming (App's `*:disabled:can-focus
       { opacity: 0.7 }`) only to FOCUSABLE widgets; this hint is non-focusable,
       so it would stay brighter than the (focusable) explorer button. Re-apply
       the same opacity so the two read identically when disabled. */
    opacity: 0.7;
}

#open-explorer-btn {
    width: auto;
    height: 3;
    margin: 0;
    padding: 0 3;
    border: none;
    background: transparent;
    color: $text;
    text-style: none;
    min-width: 0;
}

#open-explorer-btn:hover {
    background: $focus-surface;
    background-tint: $foreground 5%;
}

#open-explorer-btn:focus {
    text-style: none;
    background: $focus-surface;
}

#open-explorer-btn.-active {
    background: transparent;
    background-tint: $foreground 10%;
    text-style: none;
}
