TabulaflowApp {
    background: $surface;
}

#chat-log {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 1 2 1;
}

/* Scrollbar */
#chat-log {
    scrollbar-color: #666666;
    scrollbar-color-hover: #3EB489;
    scrollbar-color-active: #3EB489;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
}

#input-row {
    dock: bottom;
    layout: horizontal;
    height: 3;
}

/* Prompt bar (UserMessage-style) and section separators. Each is a
   single-glyph Static rendered in a 3-row container with vertical
   padding, so the visible bar spans only the middle row even though
   the surrounding sections are 3 rows tall. */
#input-prompt {
    width: 1;
    height: 3;
    padding: 1 0;
    background: transparent;
    color: #3EB489;
    text-style: bold;
}

.input-sep {
    width: 1;
    height: 3;
    padding: 1 0;
    background: transparent;
    color: #666666;
}

#input-bar {
    /* No background box; the mint bar is rendered by the sibling
       ``#input-prompt`` Static (single-row glyph) instead of a CSS
       border, so the bar height matches the text row. */
    width: 1fr;
    height: 3;
    border: none;
    padding: 1 1;
    background: transparent;
}

#input-bar:focus {
    border: none;
    background: transparent;
}

#input-esc-hint {
    /* Fixed width sized for the longer label ("Esc  Go to results" = 18
       chars) + horizontal padding (2 + 2). Prevents the hint from
       resizing when the label toggles between "Go to results" and
       "Go to input", which would otherwise shift "Esc" horizontally. */
    width: 22;
    height: 3;
    padding: 1 2;
    background: transparent;
}

#open-explorer-btn {
    width: auto;
    height: 3;
    margin: 0;
    padding: 0 3;
    border: none;
    background: transparent;
    color: $text;
    text-style: none;
    min-width: 0;
}

#open-explorer-btn:hover {
    background: $focus-surface;
    background-tint: $foreground 5%;
}

#open-explorer-btn:focus {
    text-style: none;
    background: $focus-surface;
}

#open-explorer-btn.-active {
    background: transparent;
    background-tint: $foreground 10%;
    text-style: none;
}
